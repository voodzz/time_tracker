/* white.qss */

#time_tracker {
    background-color: #ffffff;
}

/* scroll area on list page */
#scrollAreaList, QCalendarWidget {
    background-color: #f5f5f5;
    border: none;
}

/* side menu */
#sideMenu {
    background-color: #e8e8e8;
    border: none;
}

/* Buttons in side menu */
#sideMenu QPushButton {
    color: #2c3e50;
    border: none;
    padding: 10px;
    background-color: #e8e8e8;
    font-size: 25px;
    font-family: 'Varela Round';
    qproperty-iconSize: 30px 30px;
    text-align:left;
}

#sideMenu QPushButton:hover {
    background-color: #d0d0d0;
}

#sideMenu QPushButton:pressed {
    background-color: #c0c0c0;
}

#sideMenu QLabel {
    color: #7f8c8d;
    font-size: 14px;
}

#listButton {
    qproperty-icon: url({{taskIcon}});
}

#histButton {
    qproperty-icon: url({{historyIcon}});
}

#settButton {
    qproperty-icon: url({{settingsIcon}});
}

#profButton {
    qproperty-icon: url({{profileIcon}});
}

/* main menu button */
QPushButton#menuButton {
   border: none;
   qproperty-icon: url({{menuIcon}}) no-repeat center center;
}

/* tasks buttons */

#taskName {
    color: #2c3e50;
    font-size: 14px;
    border: none;
    background-color: #f5f5f5;
}

#addTaskButton {
    color: #2c3e50;
    border: none;
    border-radius: 19px;
    padding: 10px;
    background-color: #e8e8e8;
    font-size: 25px;
    font-family: 'Varela Round';
    text-align:center;
}

#addTaskButton:hover {
    background-color: #d0d0d0;
}

#addTaskButton:pressed {
    background-color: #c0c0c0;
}

#historyHeader {
    color: #2c3e50;
    font-size: 20px;
    padding: 10px;
}

#historyCalendar {
    background-color: #f5f5f5;
    color: #2c3e50;
    selection-background-color: #e8e8e8;
}

#historyTaskTable {
    background-color: #e8e8e8;
    color: #2c3e50;
    border: 1px solid #d0d0d0;
}

#historyTaskTable QHeaderView::section {
    background-color: #d0d0d0;
    color: #2c3e50;
    padding: 4px;
    border: 1px solid #c0c0c0;
}
